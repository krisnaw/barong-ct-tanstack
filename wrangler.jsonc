{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prod-barong-ct",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Payment due window is 5 minutes — check often enough to expire unpaid checkouts.
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "EMAIL_PROVIDER": "cloudflare",
    "EMAIL_FROM": "noreply@barongmelali.com",
    "EMAIL_FROM_NAME": "Barong Cycling Team",
    "PAYMENT_PROVIDER": "stub"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "prod-barong-ct"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barong-ct",
      "database_id": "e3ba49c7-b98f-4260-b33b-65d89bc007bd",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "staging-barong-ct",
      "routes": [
        {
          "pattern": "staging.barongcycling.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "noreply@barongmelali.com",
        "EMAIL_FROM_NAME": "Barong Cycling Team",
        "PAYMENT_PROVIDER": "doku",
        "PAYMENT_PUBLIC_URL": "https://staging.barongcycling.com",
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS",
          "bucket_name": "staging-barong-ct"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "barong-ct-staging",
          "database_id": "909971a1-a2be-44ec-9781-0495273c565a",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
