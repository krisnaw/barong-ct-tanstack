{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prod-barong-ct",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "prod.barongcycling.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    // Payment due window is 5 minutes — check often enough to expire unpaid checkouts.
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "noreply@barongmelali.com",
    "EMAIL_FROM_NAME": "Barong Cycling Team",
    "PAYMENT_PROVIDER": "doku",
    "PAYMENT_PUBLIC_URL": "https://prod.barongcycling.com"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "prod-barong-ct"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barong-ct-v2",
      "database_id": "10a4e09c-f607-4f0a-b709-8c7cd986d71c",
      "migrations_dir": "db/migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "staging-barong-ct",
      "routes": [
        {
          "pattern": "staging.barongcycling.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM": "noreply@barongmelali.com",
        "EMAIL_FROM_NAME": "Barong Cycling Team",
        "PAYMENT_PROVIDER": "doku",
        "PAYMENT_PUBLIC_URL": "https://staging.barongcycling.com",
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "r2_buckets": [
        {
          "binding": "AVATARS",
          "bucket_name": "staging-barong-ct"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "barong-ct-staging-v2",
          "database_id": "0d1c291f-861d-4ba5-8166-e0a515f95615",
          "migrations_dir": "db/migrations"
        }
      ]
    }
  }
}
